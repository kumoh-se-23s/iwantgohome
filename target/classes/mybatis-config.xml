<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>

    <!-- db.properties 의 값을 ${...} 로 사용 -->
    <properties resource="db.properties"/>

    <settings>
        <!-- DB 컬럼 snake_case(project_name) ↔ 자바 필드 camelCase(projectName) 자동 매핑 -->
        <setting name="mapUnderscoreToCamelCase" value="true"/>
        <!-- null 파라미터를 JDBC NULL 로 전달 (reject_reason, project_status 등 NULL 허용 컬럼) -->
        <setting name="jdbcTypeForNull" value="NULL"/>
        <!-- 락 대기 등으로 쿼리가 무한정 걸리지 않도록 (초) -->
        <setting name="defaultStatementTimeout" value="30"/>
        <!-- 실행되는 SQL 을 콘솔에서 보고 싶으면 아래 주석을 해제 -->
        <!-- <setting name="logImpl" value="STDOUT_LOGGING"/> -->
    </settings>

    <!-- XML 에서 패키지명 없이 클래스 이름만 쓰기 위한 별칭 -->
    <typeAliases>
        <package name="crowdfunding.model.domain"/>
        <package name="crowdfunding.model.dto"/>
    </typeAliases>

    <!-- DB ENUM 문자열('in_progress') ↔ 자바 enum(ProjectStatus.IN_PROGRESS) 변환기 -->
    <typeHandlers>
        <typeHandler handler="crowdfunding.model.dao.CodeEnumTypeHandler" javaType="crowdfunding.model.enums.Role"/>
        <typeHandler handler="crowdfunding.model.dao.CodeEnumTypeHandler" javaType="crowdfunding.model.enums.ApprovalStatus"/>
        <typeHandler handler="crowdfunding.model.dao.CodeEnumTypeHandler" javaType="crowdfunding.model.enums.ProjectStatus"/>
    </typeHandlers>

    <environments default="dev">
        <environment id="dev">
            <!-- 트랜잭션은 JDBC 커넥션의 commit/rollback 으로 직접 관리 (TransactionManager 참고) -->
            <transactionManager type="JDBC"/>
            <!-- 커넥션 풀: 2차 멀티스레드 서버에서 여러 요청이 동시에 DB 를 사용 -->
            <dataSource type="POOLED">
                <property name="driver" value="${db.driver}"/>
                <property name="url" value="${db.url}"/>
                <property name="username" value="${db.username}"/>
                <property name="password" value="${db.password}"/>
                <property name="poolMaximumActiveConnections" value="20"/>
                <property name="poolMaximumIdleConnections" value="5"/>
                <property name="poolPingEnabled" value="true"/>
                <property name="poolPingQuery" value="SELECT 1"/>
                <property name="poolPingConnectionsNotUsedFor" value="60000"/>
            </dataSource>
        </environment>
    </environments>

    <mappers>
        <mapper resource="mapper/UserMapper.xml"/>
        <mapper resource="mapper/CategoryMapper.xml"/>
        <mapper resource="mapper/ProjectMapper.xml"/>
        <mapper resource="mapper/RewardMapper.xml"/>
        <mapper resource="mapper/FundingMapper.xml"/>
        <mapper resource="mapper/ReviewMapper.xml"/>
        <mapper resource="mapper/LikeMapper.xml"/>
        <mapper resource="mapper/DataInitMapper.xml"/>
    </mappers>
</configuration>
