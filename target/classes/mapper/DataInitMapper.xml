<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="crowdfunding.model.dao.DataInitMapper">

    <!-- FK 가 걸린 테이블을 TRUNCATE 하려면 같은 커넥션에서 FK 검사를 잠시 끈다 -->
    <update id="disableForeignKeyChecks">SET FOREIGN_KEY_CHECKS = 0</update>
    <update id="enableForeignKeyChecks">SET FOREIGN_KEY_CHECKS = 1</update>

    <!-- TRUNCATE 는 AUTO_INCREMENT 도 1부터 다시 시작 → 시드 데이터 PK 가 항상 같음.
         ${} 는 문자열 치환이므로 코드 안의 고정 테이블명만 넘긴다 -->
    <update id="truncateTable">TRUNCATE TABLE ${tableName}</update>
</mapper>
