<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="crowdfunding.model.dao.LikeMapper">

    <insert id="insertLike">
        INSERT INTO project_like (project_id, user_id) VALUES (#{projectId}, #{userId})
    </insert>

    <select id="existsLike" resultType="boolean">
        SELECT EXISTS (SELECT 1 FROM project_like WHERE project_id = #{projectId} AND user_id = #{userId})
    </select>

    <!-- [2차] 좋아요 취소: DELETE FROM project_like WHERE project_id = ? AND user_id = ? -->
</mapper>
