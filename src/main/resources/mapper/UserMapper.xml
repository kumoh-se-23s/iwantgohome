<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- user 테이블. `user` 는 MySQL 키워드와 겹칠 수 있어서 백틱으로 감싼다 -->
<mapper namespace="crowdfunding.model.dao.UserMapper">

    <!-- 로그인 아이디 컬럼 id 를 자바 필드 loginId 로 받기 위해 별칭(login_id)을 붙인다 -->
    <sql id="userColumns">
        user_id, id AS login_id, pw, role, user_name, phone_number
    </sql>

    <select id="findById" resultType="User">
        SELECT <include refid="userColumns"/>
          FROM `user`
         WHERE user_id = #{userId}
    </select>

    <!-- [D · 검사 05] 이름 · 연락처 · 비밀번호 수정 (Service 에서 바뀌지 않는 값은 기존 값으로 채워서 넘긴다) -->
    <update id="updateProfile" parameterType="User">
        UPDATE `user`
           SET user_name    = #{userName},
               phone_number = #{phoneNumber},
               pw           = #{pw}
         WHERE user_id = #{userId}
    </update>

</mapper>
