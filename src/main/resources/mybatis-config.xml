<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-config.dtd">
<!--
    MyBatis 전체 설정
    - DB 접속 정보(environments)는 여기 두지 않는다.
      config/db.properties → PooledDataSource(DBCP 커넥션 풀) → MyBatisConfig.java 에서 연결한다.
-->
<configuration>

    <settings>
        <!-- DB 컬럼 project_name → 자바 필드 projectName 으로 자동 연결 -->
        <setting name="mapUnderscoreToCamelCase" value="true"/>
        <!-- null 값을 파라미터로 넘길 때 JDBC 타입을 NULL 로 지정 (MySQL 에서 안전) -->
        <setting name="jdbcTypeForNull" value="NULL"/>
        <!-- 쿼리 하나가 30초 이상 걸리면 중단 (락 대기 등으로 프로그램이 멈추는 것 방지) -->
        <setting name="defaultStatementTimeout" value="30"/>
        <!-- 실행되는 SQL 을 콘솔에서 보고 싶으면 아래 한 줄의 주석을 푼다 (디버깅용) -->
        <!-- <setting name="logImpl" value="STDOUT_LOGGING"/> -->
    </settings>

    <!-- resultType / parameterType 에 패키지명 없이 클래스 이름만 쓰기 위한 별칭 -->
    <typeAliases>
        <package name="crowdfunding.model.domain"/>
        <package name="crowdfunding.model.dto"/>
    </typeAliases>

    <!-- 테이블별 SQL 파일 -->
    <mappers>
        <mapper resource="mapper/UserMapper.xml"/>
        <mapper resource="mapper/SupporterMapper.xml"/>
        <mapper resource="mapper/CategoryMapper.xml"/>
        <mapper resource="mapper/ProjectMapper.xml"/>
        <mapper resource="mapper/RewardMapper.xml"/>
        <mapper resource="mapper/FundingMapper.xml"/>
        <mapper resource="mapper/ReviewMapper.xml"/>
    </mappers>
</configuration>
